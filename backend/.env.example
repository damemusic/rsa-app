# Anthropic API key used by /api/claude and the belief/rewrite helpers.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3001

SUPABASE_URL=your_supabase_project_url
# Anon key. Also used to verify the access token each request carries.
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key. Every data route runs on this and bypasses RLS, which is
# why requireAuth/requireSelf guard them.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated browser origins allowed to call the API. Netlify deploy
# previews of a listed site are accepted automatically. Falls back to the
# production Netlify URL when unset.
ALLOWED_ORIGINS=https://harmonious-cassata-9d5220.netlify.app

# Shared secret for /api/admin/* routes, sent as the X-Admin-Secret header.
# Leave unset to disable those routes entirely (they answer 503).
ADMIN_SECRET=
